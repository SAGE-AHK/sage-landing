# Origen de la consola SAGE. Los botones abren /login y /register ahí.
VITE_SAGE_APP_URL=http://localhost:3000

# URL pública de esta landing, sin barra final.
# Canonical, Open Graph, sitemap y JSON-LD: debe ser el dominio exacto del link que compartís
# (ej. https://sage-landing-two.vercel.app). En Vercel, si no la definís, el build usa VERCEL_URL.
# En desarrollo local se puede omitir.
VITE_SITE_URL=https://sage-landing-two.vercel.app
